import java_cup.runtime.*;
import java.io.*;
import java.util.*;

parser code 
{:

  public static void main(String[] args) throws Exception 
  {
    XmlToJson xmlToJson = new XmlToJson(new FileReader(args[0]));
    parser p = new parser(xmlToJson);
    Object result = p.parse().value;

    p.createCodeJson();
  }

  StringBuilder stringJson = new StringBuilder();
  Integer contador = 0;

  public void createCodeJson() throws Exception
  {
      try(PrintWriter out = new PrintWriter("output.txt"))
      {
          out.println("{");
          out.println(stringJson.toString());
          out.println("}");
      }
  }

  public void convertLists()
  {

  }

